    "problem_statement": {
      "title": "문제 의식",
      "content": [
        "5G Open RAN 아키텍처는 유연성과 비용 효율성을 제공하지만 새로운 보안 취약점을 도입",
        "F1 인터페이스(CU-DU 연결)는 공개 표준화되어 있어 공격 표면 확대",
        "기존 연구는 이론적 분석에 집중, 실제 구현 부재",
        "보안 학습자의 진입 장벽이 높음"
      ]
    },
    "oran_structure": {
      "title": "O-RAN 구조",
      "content": [
        "CU-CP: RRC, PDCP 제어 신호 처리",
        "CU-UP: SDAP, PDCP 데이터 전달",
        "DU: RLC, MAC, PHY-high 처리",
        "F1-C: 제어 평면 (SCTP, 포트 38472)",
        "F1-U: 사용자 평면 (GTP-U, UDP, 포트 2152)"
      ],
      "diagram": "O-RAN 아키텍처 다이어그램"
    },
    "our_approach": {
      "title": "우리의 접근법",
      "content": [
        "공격 구현: F1-C 6종, F1-U 3종, 분산 봇넷 시뮬레이션",
        "3-Layer 탐지: Threshold → Statistical → ML (97% 정확도)",
        "자동화 방어: IP 필터링, Rate Limiting, DU 재연결, IP 회전",
        "통합 플랫폼: 웹 대시보드로 실시간 제어 및 모니터링",
        "교육 목적: 오픈소스 코드 제공, 학습자 커스터마이징 가능"
      ],
      "features": [
        "9가지 공격 타입",
        "3-Layer 탐지 시스템",
        "6가지 방어 메커니즘",
        "5가지 시나리오",
        "웹 기반 대시보드"
      ]
    },
